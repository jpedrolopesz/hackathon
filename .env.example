# Ambiente
NODE_ENV=development
APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:3000

# AWS
AWS_REGION=us-east-1

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Emissor real dos tokens (https://cognito-idp.{region}.amazonaws.com/{userPoolId}) -
# usado por aws-jwt-verify para validar assinatura/expiração
COGNITO_ISSUER_URL=
# Domínio do Hosted UI (https://{prefix}.auth.{region}.amazoncognito.com)
COGNITO_HOSTED_UI_DOMAIN=
# ARN do Secrets Manager com a chave do cookie de sessão do painel (nunca a chave em si)
SESSION_SECRET_ARN=

# DynamoDB (tabela única - decisão em docs/fase-1-arquitetura.md)
DYNAMODB_TABLE_NAME=

# IVS (só a Lambda consumidora de EventBridge usa - opcionais para as demais)
IVS_ENCODER_CONFIGURATION_ARN=
IVS_STORAGE_CONFIGURATION_ARN=
# Teto por ambiente; a duração real é duração agendada da aula + 30min de margem.
IVS_PARTICIPANT_TOKEN_MAX_DURATION_MINUTES=720

# Sharding da partição de chat (LIVE#{liveId}#{shard}) - default 1 (sem sharding)
CHAT_SHARD_COUNT=1

# S3 (gravações)
S3_RECORDINGS_BUCKET_NAME=

# CloudFront (cookies assinados para playback privado de HLS - manifesto + segmentos,
# nunca uma URL única assinada; ver docs/fase-1-arquitetura.md, seção 13). Playback é
# servido sob /media/* da MESMA distribuição do painel (cookie first-party) - por
# isso não há um CLOUDFRONT_DOMAIN_NAME aqui: o domínio vem do Host de cada
# requisição, nunca de env var fixa (evita dependência circular no CloudFormation).
CLOUDFRONT_KEY_PAIR_ID=
# ARN do Secrets Manager que guarda a chave privada — nunca a chave em si.
CLOUDFRONT_PRIVATE_KEY_SECRET_ARN=
# Teto absoluto do cookie de playback (a validade real é duração da gravação +
# margem, nunca fixa) - default 360min/6h, ajustável por ambiente
PLAYBACK_COOKIE_MAX_TTL_MINUTES=360

# EventBridge
EVENTBRIDGE_BUS_NAME=

# API Gateway WebSocket (endpoint de management API usado pelas Lambdas)
WEBSOCKET_API_ENDPOINT=
# URL wss:// que o navegador usa para conectar (diferente do endpoint acima)
WEBSOCKET_CLIENT_URL=

# Retenção de mensagens de chat via TTL do DynamoDB (seção 14 do README) - só a
# Lambda $default do WebSocket usa; dias corridos desde a criação da mensagem
CHAT_MESSAGE_RETENTION_DAYS=30

# Observabilidade
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
